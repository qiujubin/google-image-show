{
    "manifest_version": 3,
    "name": "Google 图片站点过滤器",
    "version": "1.4.1",
    "version_name": "1.4.1 – 单一过滤模式与弹窗切换修复",
    "description": "只显示指定网站的 Google 图片搜索结果",
    "permissions": [
        "storage",
        "tabs"
    ],
    "action": {
        "default_title": "Google 图片站点过滤器",
        "default_icon": {
            "48": "icon.png"
        },
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.google.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "options_page": "options.html",
    "icons": {
        "48": "icon.png"
    }
}
